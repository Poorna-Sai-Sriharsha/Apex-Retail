# Database
DATABASE_URL=sqlite+aiosqlite:///./store_intelligence.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@db:5432/store_intelligence

# API Settings
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Store Configuration
STORE_IDS=STORE_BLR_001,STORE_BLR_002,STORE_BLR_003,STORE_BLR_004,STORE_BLR_005,ST1008

# Pipeline Settings
PIPELINE_OUTPUT_DIR=./pipeline/output
STALE_FEED_MINUTES=10
REID_SIMILARITY_THRESHOLD=0.75
REID_REENTRY_WINDOW_MINUTES=30
STAFF_HSV_CONFIDENCE_THRESHOLD=0.7
ZONE_DWELL_INTERVAL_SECONDS=30
POS_CORRELATION_WINDOW_MINUTES=5
QUEUE_ABANDON_WINDOW_MINUTES=5

# Anomaly Detection Thresholds
QUEUE_SPIKE_MULTIPLIER=2.0
CONVERSION_DROP_THRESHOLD=0.70
DEAD_ZONE_MINUTES=30
